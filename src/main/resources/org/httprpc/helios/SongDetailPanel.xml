<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE row-panel SYSTEM "sierra.dtd">

<row-panel spacing="8" padding="2, 4, 2, 4">
    <stack-panel>
        <label name="trackNumberLabel" horizontalAlignment="trailing" enabled="false"/>
        <label name="nowPlayingLabel" icon="icons/sensors_24dp.svg; 18" horizontalAlignment="trailing" enabled="false"/>
    </stack-panel>

    <label name="titleLabel" weight="1"/>

    <row-panel name="buttonPanel">
        <button name="playFromButton" icon="icons/play_arrow_24dp.svg; 18"
            focusable="false"
            toolTipText="playFrom"
            style="buttonType: borderless"/>

        <menu-button name="addToPlaylistButton" icon="icons/playlist_add_24dp.svg; 18"
            focusable="false"
            toolTipText="addToPlaylist"
            style="buttonType: borderless"/>

        <button name="editSongButton" icon="icons/edit_24dp.svg; 16"
            focusable="false"
            toolTipText="editSong"
            style="buttonType: borderless"/>

        <button name="deleteSongButton" icon="icons/delete_24dp.svg; 18"
            focusable="false"
            toolTipText="deleteSong"
            style="buttonType: borderless"/>
    </row-panel>

    <label name="timeLabel" horizontalAlignment="trailing" enabled="false"/>
</row-panel>
