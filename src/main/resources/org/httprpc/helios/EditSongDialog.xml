<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE column-panel SYSTEM "sierra.dtd">

<column-panel spacing="8" padding="8" opaque="true">
    <form-panel>
        <text-field name="artistTextField" label="artist" columns="32"/>
        <text-field name="albumTextField" label="album" columns="32"/>
        <text-field name="titleTextField" label="title" columns="32"/>

        <spacer height="4"/>

        <suggestion-picker name="genreSuggestionPicker" label="genre" columns="12"/>
        <number-field name="yearTextField" label="year" columns="4"/>

        <spacer height="4"/>

        <number-field label="trackNumber" name="trackNumberTextField" columns="2"/>
        <number-field label="discNumber" name="discNumberTextField" columns="2"/>

        <spacer height="4"/>

        <check-box name="compilationCheckBox" text="compilation"/>
    </form-panel>

    <separator/>

    <row-panel>
        <column-panel>
            <spacer weight="1"/>
            <row-panel>
                <button name="previousButton" icon="icons/chevron_left_24dp.svg; 18"
                    style="buttonType: borderless"
                    toolTipText="previous"/>
                <button name="nextButton" icon="icons/chevron_right_24dp.svg; 18"
                    style="buttonType: borderless"
                    toolTipText="next"/>
            </row-panel>
            <spacer weight="1"/>
        </column-panel>

        <spacer weight="1"/>

        <row-panel spacing="8">
            <button name="cancelButton" text="cancel"/>
            <button name="okButton" text="ok"/>
        </row-panel>
    </row-panel>
</column-panel>
