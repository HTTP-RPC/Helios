<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE column-panel SYSTEM "sierra.dtd">

<column-panel spacing="1" opaque="true" background="Component.borderColor">
    <row-panel spacing="4" alignToBaseline="true" padding="8" opaque="true" background="Panel.background">
        <label name="nameLabel" styleClass="h1"/>
        <button name="playSelectionButton" icon="icons/play_arrow_24dp.svg; 20"
            focusable="false"
            toolTipText="playSelection"
            style="buttonType: borderless"/>

        <spacer weight="1"/>

        <row-panel>
            <menu-button name="addToPlaylistButton" icon="icons/playlist_add_24dp.svg; 18"
                focusable="false"
                toolTipText="addToPlaylist"
                style="buttonType: borderless"/>

            <menu-button name="editSelectionButton" icon="icons/edit_24dp.svg; 16"
                focusable="false"
                toolTipText="editSelection"
                style="buttonType: borderless">
                <menu-item name="editAlbumMenuItem" text="album" icon="icons/album_24dp.svg; 18"/>
                <menu-item name="editArtworkMenuItem" text="artwork" icon="icons/photo_24dp.svg; 18"/>
            </menu-button>

            <menu-button name="deleteSelectionButton" icon="icons/delete_24dp.svg; 18"
                focusable="false"
                toolTipText="deleteSelection"
                style="buttonType: borderless">
                <menu-item name="deleteAlbumMenuItem" text="album" icon="icons/album_24dp.svg; 18"/>
                <menu-item name="deleteArtworkMenuItem" text="artwork" icon="icons/photo_24dp.svg; 18"/>
            </menu-button>
        </row-panel>
    </row-panel>

    <row-panel spacing="1" weight="1">
        <scroll-pane border="none" weight="1">
            <list name="artistAlbumList" selectionMode="single-selection"/>
        </scroll-pane>

        <scroll-pane border="none" weight="1">
            <list name="songList" selectionMode="single-selection"/>
        </scroll-pane>
    </row-panel>
</column-panel>
