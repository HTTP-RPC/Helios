<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE column-panel SYSTEM "sierra.dtd">

<column-panel spacing="8" padding="8" opaque="true">
    <text-field name="titleTextField" columns="18"
        leadingIcon="icons/search_24dp.svg; 18"
        showClearButton="true"/>

    <stack-panel size="480, 320" border="Component.borderColor, 1, solid, 4">
        <scroll-pane border="none">
            <list name="resultList" selectionMode="single-selection" focusable="false"/>
        </scroll-pane>
    </stack-panel>
</column-panel>
