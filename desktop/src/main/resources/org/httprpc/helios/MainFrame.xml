<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE column-panel SYSTEM "sierra.dtd">

<column-panel spacing="4" padding="4, 8, 8, 8" opaque="true">
    <row-panel spacing="16">
        <row-panel spacing="8" weight="1.25">
            <row-panel spacing="2">
                <column-panel>
                    <spacer weight="1"/>
                    <button name="playPauseButton" focusable="false" style="buttonType: borderless"/>
                    <spacer weight="1"/>
                </column-panel>

                <column-panel>
                    <spacer weight="1"/>
                    <row-panel spacing="2">
                        <button name="previousButton" icon="icons/skip_previous_24dp.svg; 18"
                            focusable="false"
                            style="buttonType: borderless"
                            toolTipText="previous"/>

                        <button name="nextButton" icon="icons/skip_next_24dp.svg; 18"
                            focusable="false"
                            style="buttonType: borderless"
                            toolTipText="next"/>
                    </row-panel>
                    <spacer weight="1"/>
                </column-panel>
            </row-panel>

            <column-panel>
                <spacer weight="1"/>
                <row-panel spacing="2">
                    <toggle-button name="shuffleButton" icon="icons/shuffle_24dp.svg; 16"
                        focusable="false"
                        style="buttonType: borderless"
                        toolTipText="shuffle"/>
                    <toggle-button name="repeatButton" icon="icons/repeat_24dp.svg; 16"
                        focusable="false"
                        style="buttonType: borderless"
                        toolTipText="repeat"/>
                </row-panel>
                <spacer weight="1"/>
            </column-panel>

            <column-panel>
                <spacer weight="1"/>
                <toggle-button name="queueButton" icon="icons/queue_music_24dp.svg; 18"
                    focusable="false"
                    style="buttonType: borderless"
                    toolTipText="queue"/>
                <spacer weight="1"/>
            </column-panel>

            <column-panel>
                <spacer weight="1"/>
                <row-panel spacing="2">
                    <menu-button name="addButton" icon="icons/add_24dp.svg; 18"
                        focusable="false"
                        style="buttonType: borderless"
                        toolTipText="add">
                        <menu-item name="addSongsMenuItem" text="songs" icon="icons/folder_24dp.svg; 18"/>
                        <menu-item name="addPlaylistMenuItem" text="playlist" icon="icons/music_note_24dp.svg; 18"/>
                    </menu-button>
                </row-panel>
                <spacer weight="1"/>
            </column-panel>
        </row-panel>

        <row-panel weight="2.75">
            <column-panel weight="1">
                <spacer weight="1"/>
                <slider name="positionSlider" enabled="false" style="thumbSize: 8, 8"/>
                <spacer weight="1"/>
            </column-panel>
        </row-panel>

        <row-panel spacing="8" weight="1.25">
            <spacer weight="1"/>

            <column-panel>
                <spacer weight="1"/>
                <row-panel spacing="4">
                    <activity-indicator name="albumArtworkActivityIndicator" indicatorStyle="small"/>

                    <button name="getAlbumArtworkButton" icon="icons/file_download_24dp.svg; 18"
                        focusable="false"
                        style="buttonType: borderless"
                        toolTipText="getAlbumArtwork"/>
                </row-panel>
                <spacer weight="1"/>
            </column-panel>

            <column-panel>
                <spacer weight="1"/>
                <row-panel spacing="2">
                    <button name="searchButton" icon="icons/search_24dp.svg; 18"
                        focusable="false"
                        style="buttonType: borderless"
                        toolTipText="search"/>

                    <button name="settingsButton" icon="icons/settings_24dp.svg; 18"
                        focusable="false"
                        style="buttonType: borderless"
                        toolTipText="settings"/>
                </row-panel>
                <spacer weight="1"/>
            </column-panel>
        </row-panel>
    </row-panel>

    <row-panel spacing="4" weight="1">
        <tabbed-pane name="collectionTabbedPane" tabPlacement="bottom"
            focusable="false"
            style="tabAreaAlignment: fill"
            border="Component.borderColor; 1"
            weight="1">
            <scroll-pane name="artistScrollPane" tabTitle="artists" tabIcon="icons/mic_24dp.svg; 18">
                <list name="artistList" selectionMode="single-selection"/>
            </scroll-pane>

            <scroll-pane name="genreScrollPane" tabTitle="genres" tabIcon="icons/piano_24dp.svg; 18">
                <list name="genreList" selectionMode="single-selection"/>
            </scroll-pane>

            <scroll-pane name="playlistScrollPane" tabTitle="playlists" tabIcon="icons/music_note_24dp.svg; 18">
                <list name="playlistList" selectionMode="single-selection"/>
            </scroll-pane>
        </tabbed-pane>

        <scroll-pane name="collectionScrollPane" border="Component.borderColor; 1" weight="2.75"/>
    </row-panel>
</column-panel>
