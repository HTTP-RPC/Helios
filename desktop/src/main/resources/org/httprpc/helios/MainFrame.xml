<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE column-panel SYSTEM "sierra.dtd">

<column-panel opaque="true">
    <row-panel spacing="16" padding="4">
        <row-panel spacing="8" weight="1.25">
            <row-panel spacing="2">
                <column-panel>
                    <spacer weight="1"/>
                    <button name="playPauseButton" focusable="false" style="buttonType: borderless"/>
                    <spacer weight="1"/>
                </column-panel>

                <column-panel>
                    <spacer weight="1"/>
                    <row-panel>
                        <button name="previousButton" icon="icons/skip_previous_24dp.svg"
                            focusable="false"
                            style="buttonType: borderless"
                            toolTipText="previous"/>

                        <button name="nextButton" icon="icons/skip_next_24dp.svg"
                            focusable="false"
                            style="buttonType: borderless"
                            toolTipText="next"/>
                    </row-panel>
                    <spacer weight="1"/>
                </column-panel>
            </row-panel>

            <column-panel>
                <spacer weight="1"/>
                <row-panel spacing="2">
                    <toggle-button name="shuffleButton" icon="icons/shuffle_24dp.svg; 18"
                        focusable="false"
                        style="buttonType: borderless"
                        toolTipText="shuffle"/>

                    <toggle-button name="repeatButton" icon="icons/repeat_24dp.svg; 18"
                        focusable="false"
                        style="buttonType: borderless"
                        toolTipText="repeat"/>
                </row-panel>
                <spacer weight="1"/>
            </column-panel>

            <column-panel>
                <spacer weight="1"/>
                <toggle-button name="queueButton" icon="icons/queue_music_24dp.svg; 20"
                    focusable="false"
                    style="buttonType: borderless"
                    toolTipText="queue"/>
                <spacer weight="1"/>
            </column-panel>

            <column-panel>
                <spacer weight="1"/>
                <menu-button name="addButton" icon="icons/add_24dp.svg; 20"
                    focusable="false"
                    style="buttonType: borderless"
                    toolTipText="add">
                    <menu-item name="addSongsMenuItem" text="songs" icon="icons/folder_24dp.svg; 18"/>
                    <menu-item name="addPlaylistMenuItem" text="playlist" icon="icons/music_note_24dp.svg; 18"/>
                </menu-button>
                <spacer weight="1"/>
            </column-panel>
        </row-panel>

        <column-panel name="currentSongPanel" spacing="4" weight="2.5">
            <row-panel spacing="8">
                <column-panel>
                    <spacer weight="1"/>
                    <image-pane name="artworkImagePane" size="30"
                        scaleMode="fill-width"
                        border="Component.borderColor, 1, solid, 4"/>
                    <spacer weight="1"/>
                </column-panel>

                <column-panel weight="1">
                    <row-panel alignToBaseline="true">
                        <label name="songTitleLabel" styleClass="h4" weight="1"/>

                        <button name="goToSongButton" icon="icons/shortcut_24dp.svg; 12"
                            focusable="false"
                            style="buttonType: borderless"
                            toolTipText="goToSong"/>
                    </row-panel>

                    <row-panel alignToBaseline="true">
                        <label name="artistAlbumLabel" styleClass="small" enabled="false" weight="1"/>
                        <label name="timeLabel" styleClass="small" enabled="false"/>
                    </row-panel>
                </column-panel>
            </row-panel>

            <progress-bar name="positionProgressBar"/>
        </column-panel>

        <row-panel spacing="8" weight="1.25">
            <spacer weight="1"/>

            <column-panel>
                <spacer weight="1"/>
                <row-panel spacing="4">
                    <activity-indicator name="albumArtworkActivityIndicator" indicatorStyle="small"/>

                    <button name="getAlbumArtworkButton" icon="icons/file_download_24dp.svg; 20"
                        focusable="false"
                        style="buttonType: borderless"
                        toolTipText="getAlbumArtwork"/>
                </row-panel>
                <spacer weight="1"/>
            </column-panel>

            <column-panel>
                <spacer weight="1"/>
                <row-panel spacing="2">
                    <button name="searchButton" icon="icons/search_24dp.svg; 20"
                        focusable="false"
                        style="buttonType: borderless"
                        toolTipText="search"/>

                    <button name="settingsButton" icon="icons/settings_24dp.svg; 20"
                        focusable="false"
                        style="buttonType: borderless"
                        toolTipText="settings"/>
                </row-panel>
                <spacer weight="1"/>
            </column-panel>
        </row-panel>
    </row-panel>

    <separator style="height: 1; stripeIndent: 0"/>

    <row-panel weight="1">
        <tabbed-pane name="collectionTabbedPane" tabPlacement="bottom"
            focusable="false"
            style="tabAreaAlignment: fill" weight="1">
            <scroll-pane tabTitle="artists" tabIcon="icons/mic_24dp.svg; 18" border="none">
                <list name="artistList" selectionMode="single-selection"/>
            </scroll-pane>

            <scroll-pane tabTitle="genres" tabIcon="icons/piano_24dp.svg; 18" border="none">
                <list name="genreList" selectionMode="single-selection"/>
            </scroll-pane>

            <scroll-pane tabTitle="playlists" tabIcon="icons/music_note_24dp.svg; 18" border="none">
                <list name="playlistList" selectionMode="single-selection"/>
            </scroll-pane>
        </tabbed-pane>

        <separator orientation="vertical" style="stripeIndent: 0"/>

        <scroll-pane name="collectionScrollPane" border="none" weight="2.75"/>
    </row-panel>
</column-panel>
