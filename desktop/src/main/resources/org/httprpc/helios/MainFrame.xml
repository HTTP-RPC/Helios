<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE column-panel SYSTEM "sierra.dtd">

<column-panel spacing="4" padding="8" opaque="true">
    <row-panel spacing="32">
        <row-panel weight="3">
            <column-panel>
                <spacer weight="1"/>
                <button name="playButton" focusable="false" style="buttonType: borderless"/>
                <spacer weight="1"/>
            </column-panel>

            <column-panel>
                <spacer weight="1"/>
                <row-panel>
                    <button name="previousButton" icon="icons/skip_previous_24dp.svg; 20"
                        focusable="false"
                        style="buttonType: borderless"
                        toolTipText="previous"/>

                    <button name="nextButton" icon="icons/skip_next_24dp.svg; 20"
                        focusable="false"
                        style="buttonType: borderless"
                        toolTipText="next"/>

                    <spacer width="8"/>

                    <toggle-button name="upNextButton" icon="icons/queue_music_24dp.svg; 20"
                        focusable="false"
                        style="buttonType: borderless"
                        toolTipText="upNext"/>
                </row-panel>
                <spacer weight="1"/>
            </column-panel>

            <spacer weight="1"/>

            <column-panel>
                <spacer weight="1"/>
                <row-panel spacing="4">
                    <toggle-button name="shuffleButton" focusable="false" style="buttonType: borderless" toolTipText="shuffle"/>
                    <toggle-button name="repeatButton" focusable="false" style="buttonType: borderless" toolTipText="repeat"/>
                </row-panel>
                <spacer weight="1"/>
            </column-panel>
        </row-panel>

        <row-panel weight="5">
            <label name="elapsedTimeLabel" styleClass="small"/>
            <slider name="positionSlider" focusable="false" weight="1"/>
            <label name="remainingTimeLabel" styleClass="small"/>
        </row-panel>

        <row-panel weight="3">
            <spacer weight="1"/>

            <column-panel>
                <spacer weight="1"/>
                <text-field name="searchTextField" columns="18" leadingIcon="icons/search_24dp.svg; 18"/>
                <spacer weight="1"/>
            </column-panel>
        </row-panel>
    </row-panel>

    <split-pane name="horizontalSplitPane" weight="1">
        <split-pane orientation="vertical" name="verticalSplitPane">
            <stack-panel>
                <column-panel padding="4">
                    <spacer weight="1"/>
                    <row-panel>
                        <spacer weight="1"/>
                        <button icon="icons/add_circle_outline_24dp.svg; 18"
                            focusable="false"
                            style="buttonType: borderless"/>
                    </row-panel>
                </column-panel>

                <scroll-pane>
                    <list name="artistList" selectionMode="single-selection"/>
                </scroll-pane>
            </stack-panel>

            <stack-panel>
                <column-panel padding="4">
                    <spacer weight="1"/>
                    <row-panel>
                        <spacer weight="1"/>
                        <button icon="icons/add_circle_outline_24dp.svg; 18"
                            focusable="false"
                            style="buttonType: borderless"/>
                    </row-panel>
                </column-panel>

                <scroll-pane>
                    <list name="playlistList" selectionMode="single-selection"/>
                </scroll-pane>
            </stack-panel>
        </split-pane>

        <scroll-pane name="albumScrollPane"/>
    </split-pane>
</column-panel>
