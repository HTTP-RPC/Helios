<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE column-panel SYSTEM "sierra.dtd">

<column-panel spacing="4" padding="8" opaque="true">
    <row-panel spacing="8">
        <row-panel spacing="8" weight="1.25">
            <row-panel spacing="2">
                <column-panel>
                    <spacer weight="1"/>
                    <button name="playButton" focusable="false" style="buttonType: borderless"/>
                    <spacer weight="1"/>
                </column-panel>

                <column-panel>
                    <spacer weight="1"/>
                    <row-panel spacing="2">
                        <button name="previousButton" icon="icons/skip_previous_24dp.svg; 18"
                            focusable="false"
                            style="buttonType: borderless"
                            toolTipText="previous"/>

                        <button name="nextButton" icon="icons/skip_next_24dp.svg; 18"
                            focusable="false"
                            style="buttonType: borderless"
                            toolTipText="next"/>
                    </row-panel>
                    <spacer weight="1"/>
                </column-panel>
            </row-panel>

            <column-panel>
                <spacer weight="1"/>
                <row-panel spacing="2">
                    <toggle-button name="shuffleButton" icon="icons/shuffle_24dp.svg; 18"
                        focusable="false"
                        style="buttonType: borderless"
                        toolTipText="shuffle"/>
                    <toggle-button name="repeatButton" icon="icons/repeat_24dp.svg; 18"
                        focusable="false"
                        style="buttonType: borderless"
                        toolTipText="repeat"/>
                </row-panel>
                <spacer weight="1"/>
            </column-panel>

            <column-panel>
                <spacer weight="1"/>
                <button name="showQueueButton" icon="icons/queue_music_24dp.svg; 18"
                    focusable="false"
                    style="buttonType: borderless"
                    toolTipText="showQueue"/>
                <spacer weight="1"/>
            </column-panel>

            <spacer weight="1"/>

            <column-panel>
                <spacer weight="1"/>
                <menu-button icon="icons/add_24dp.svg; 18" focusable="false" style="buttonType: borderless" toolTipText="add">
                    <menu-item text="songs" icon="icons/folder_24dp.svg; 18"/>
                    <menu-item text="playlist" icon="icons/playlist_add_24dp.svg; 18"/>
                </menu-button>
                <spacer weight="1"/>
            </column-panel>
        </row-panel>

        <row-panel weight="2.75">
            <label name="elapsedTimeLabel" styleClass="small"/>
            <slider name="positionSlider" focusable="false" weight="1"/>
            <label name="remainingTimeLabel" styleClass="small"/>
        </row-panel>

        <row-panel weight="1.25">
            <spacer weight="1"/>

            <column-panel weight="4">
                <spacer weight="1"/>
                <text-field name="searchTextField" leadingIcon="icons/search_24dp.svg; 18"/>
                <spacer weight="1"/>
            </column-panel>
        </row-panel>
    </row-panel>

    <row-panel spacing="4" weight="1">
        <column-panel spacing="4" weight="1">
            <scroll-pane weight="2">
                <list name="artistList" selectionMode="single-selection" visibleRowCount="10"/>
            </scroll-pane>

            <scroll-pane weight="1">
                <list name="playlistList" selectionMode="single-selection" visibleRowCount="5"/>
            </scroll-pane>
        </column-panel>

        <scroll-pane weight="3"/>
    </row-panel>
</column-panel>
