<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE column-panel SYSTEM "sierra.dtd">

<column-panel spacing="4" padding="8" opaque="true">
    <row-panel spacing="16">
        <row-panel spacing="8" weight="1.25">
            <row-panel spacing="2">
                <column-panel>
                    <spacer weight="1"/>
                    <button name="playPauseButton" focusable="false" style="buttonType: borderless"/>
                    <spacer weight="1"/>
                </column-panel>

                <column-panel>
                    <spacer weight="1"/>
                    <row-panel spacing="2">
                        <button name="previousButton" icon="icons/skip_previous_24dp.svg; 18"
                            focusable="false"
                            style="buttonType: borderless"
                            toolTipText="previous"/>

                        <button name="nextButton" icon="icons/skip_next_24dp.svg; 18"
                            focusable="false"
                            style="buttonType: borderless"
                            toolTipText="next"/>
                    </row-panel>
                    <spacer weight="1"/>
                </column-panel>
            </row-panel>

            <column-panel>
                <spacer weight="1"/>
                <row-panel spacing="2">
                    <toggle-button name="shuffleButton" icon="icons/shuffle_24dp.svg; 18"
                        focusable="false"
                        style="buttonType: borderless"
                        toolTipText="shuffle"/>
                    <toggle-button name="repeatButton" icon="icons/repeat_24dp.svg; 18"
                        focusable="false"
                        style="buttonType: borderless"
                        toolTipText="repeat"/>
                </row-panel>
                <spacer weight="1"/>
            </column-panel>

            <column-panel>
                <spacer weight="1"/>
                <button name="queueButton" icon="icons/queue_music_24dp.svg; 18"
                    focusable="false"
                    style="buttonType: borderless"
                    toolTipText="queue"/>
                <spacer weight="1"/>
            </column-panel>

            <spacer weight="1"/>

            <column-panel>
                <spacer weight="1"/>
                <row-panel spacing="8">
                    <menu-button name="addButton" icon="icons/add_24dp.svg; 18"
                        focusable="false"
                        style="buttonType: borderless"
                        toolTipText="add">
                        <menu-item name="addSongsMenuItem" text="songs" icon="icons/folder_24dp.svg; 18"/>
                        <menu-item name="addPlaylistMenuItem" text="playlist" icon="icons/music_note_24dp.svg; 18"/>
                    </menu-button>
                </row-panel>
                <spacer weight="1"/>
            </column-panel>
        </row-panel>

        <row-panel weight="3">
            <label name="elapsedTimeLabel" horizontalAlignment="trailing"
                styleClass="small"
                weight="1"/>

            <slider name="positionSlider" focusable="false" weight="9"/>

            <label name="remainingTimeLabel"
                styleClass="small"
                weight="1"/>
        </row-panel>

        <row-panel weight="1.25">
            <spacer weight="1"/>

            <column-panel>
                <spacer weight="1"/>
                <row-panel spacing="2">
                    <button name="searchButton" icon="icons/search_24dp.svg; 18"
                        focusable="false"
                        style="buttonType: borderless"
                        toolTipText="search"/>

                    <button name="settingsButton" icon="icons/settings_24dp.svg; 18"
                        focusable="false"
                        style="buttonType: borderless"
                        toolTipText="settings"/>
                </row-panel>
                <spacer weight="1"/>
            </column-panel>
        </row-panel>
    </row-panel>

    <row-panel spacing="4" weight="1">
        <tabbed-pane name="collectionTabbedPane" tabPlacement="bottom"
            focusable="false"
            style="tabAreaAlignment: fill"
            border="Component.borderColor; 1"
            weight="1">
            <stack-panel tabTitle="artists" tabIcon="icons/piano_24dp.svg; 18">
                <label name="noArtistsLabel" text="noArtists" horizontalAlignment="center"/>

                <scroll-pane name="artistScrollPane">
                    <list name="artistList" selectionMode="single-selection"/>
                </scroll-pane>
            </stack-panel>

            <stack-panel tabTitle="playlists" tabIcon="icons/music_note_24dp.svg; 18">
                <label name="noPlaylistsLabel" text="noPlaylists" horizontalAlignment="center"/>

                <scroll-pane name="playlistScrollPane">
                    <list name="playlistList" selectionMode="single-selection"/>
                </scroll-pane>
            </stack-panel>
        </tabbed-pane>

        <scroll-pane name="collectionScrollPane" border="Component.borderColor; 1" weight="3"/>
    </row-panel>
</column-panel>
