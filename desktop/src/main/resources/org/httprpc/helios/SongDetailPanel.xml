<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE row-panel SYSTEM "sierra.dtd">

<row-panel spacing="4" alignToBaseline="true" padding="4, 0, 4, 0">
    <label name="titleLabel"/>

    <button name="playSongButton" icon="icons/play_arrow_24dp.svg; 18"
        focusable="false"
        toolTipText="playSong"
        style="buttonType: borderless"/>

    <spacer weight="1"/>

    <row-panel spacing="2">
        <button name="deleteButton" icon="icons/delete_24dp.svg; 18"
            focusable="false"
            toolTipText="deleteSong"
            style="buttonType: borderless"/>

        <button name="editButton" icon="icons/edit_24dp.svg; 16"
            focusable="false"
            toolTipText="editSong"
            style="buttonType: borderless"/>
    </row-panel>

    <label name="timeLabel"/>
</row-panel>
