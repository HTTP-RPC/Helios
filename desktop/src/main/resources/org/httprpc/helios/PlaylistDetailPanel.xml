<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE column-panel SYSTEM "sierra.dtd">

<column-panel spacing="8">
    <row-panel spacing="4" alignToBaseline="true">
        <text-field name="nameTextField" focusable="false" editable="false" opaque="false" styleClass="h1"/>
        <button name="playAllButton" icon="icons/play_arrow_24dp.svg; 20"
            focusable="false"
            toolTipText="playAll"
            style="buttonType: borderless"/>

        <spacer weight="1"/>

        <row-panel spacing="2">
            <menu-button name="removeFromPlaylistButton" icon="icons/remove_24dp.svg; 18"
                focusable="false"
                toolTipText="removeFromPlaylist"
                style="buttonType: borderless"/>

            <spacer width="8"/>

            <button name="editNameButton" icon="icons/edit_24dp.svg; 16"
                focusable="false"
                toolTipText="editName"
                style="buttonType: borderless"/>

            <button name="deletePlaylistButton" icon="icons/delete_24dp.svg; 18"
                focusable="false"
                toolTipText="deletePlaylist"
                style="buttonType: borderless"/>
        </row-panel>
    </row-panel>

    <scroll-pane weight="1">
        <table name="songTable"/>
    </scroll-pane>
</column-panel>
