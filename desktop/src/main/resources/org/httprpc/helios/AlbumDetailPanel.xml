<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE column-panel SYSTEM "sierra.dtd">

<column-panel spacing="8">
    <row-panel spacing="4" alignToBaseline="true">
        <label name="nameLabel" styleClass="h2"/>
        <button name="playAlbumButton" icon="icons/play_arrow_24dp.svg; 18"
            focusable="false"
            toolTipText="playAlbum"
            style="buttonType: borderless"/>
    </row-panel>

    <row-panel spacing="16">
        <column-panel spacing="2">
            <stack-panel name="artworkPanel">
                <column-panel>
                    <spacer weight="1"/>

                    <row-panel name="artworkButtonPanel" spacing="2" padding="2, 4, 2, 4" background="Component.borderColor; 0.9">
                        <spacer weight="1"/>

                        <button name="editArtworkButton" icon="icons/edit_24dp.svg; 14"
                            focusable="false"
                            toolTipText="editArtwork"
                            style="buttonType: borderless"/>
                        <button name="deleteArtworkButton" icon="icons/delete_24dp.svg; 16"
                            focusable="false"
                            toolTipText="deleteArtwork"
                            style="buttonType: borderless"/>
                    </row-panel>
                </column-panel>

                <image-pane name="artworkImagePane" size="180" scaleMode="fill-width" border="Component.borderColor"/>

                <label icon="icons/photo_24dp.svg; 48" horizontalAlignment="center"/>
            </stack-panel>

            <spacer height="4"/>

            <label name="genreLabel" horizontalAlignment="center" styleClass="medium" enabled="false"/>
            <label name="yearLabel" horizontalAlignment="center" styleClass="small" enabled="false"/>

            <spacer weight="1"/>
        </column-panel>

        <column-panel name="songListPanel" weight="1"/>
    </row-panel>
</column-panel>
