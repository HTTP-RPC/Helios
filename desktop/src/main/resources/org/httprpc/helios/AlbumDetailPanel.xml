<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE column-panel SYSTEM "sierra.dtd">

<column-panel spacing="8">
    <label name="nameLabel" styleClass="h2"/>

    <row-panel spacing="16">
        <column-panel>
            <image-pane name="imagePane" size="180" scaleMode="fill-width" border="Component.borderColor"/>
            <spacer weight="1"/>
        </column-panel>

        <column-panel spacing="4" weight="1">
            <separator/>
            <list name="songList" selectionMode="single-selection" opaque="false"/>
        </column-panel>
    </row-panel>
</column-panel>
