<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE column-panel SYSTEM "sierra.dtd">

<column-panel spacing="8">
    <row-panel spacing="4">
        <label name="nameLabel" styleClass="h2"/>
        <button name="playAlbumButton" icon="icons/play_arrow_24dp.svg; 18"
            focusable="false"
            toolTipText="playAlbum"
            style="buttonType: borderless"/>
    </row-panel>

    <row-panel spacing="16">
        <column-panel>
            <image-pane name="imagePane" size="180" scaleMode="fill-width" border="Component.borderColor"/>
            <spacer weight="1"/>
        </column-panel>

        <column-panel name="songListPanel" weight="1"/>
    </row-panel>
</column-panel>
