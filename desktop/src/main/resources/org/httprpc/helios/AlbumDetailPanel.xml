<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE row-panel SYSTEM "sierra.dtd">

<row-panel spacing="8">
    <column-panel>
        <image-pane name="imagePane" width="180" scaleMode="fill-width" border="Component.borderColor"/>
        <spacer weight="1"/>
    </column-panel>

    <column-panel spacing="4" weight="1">
        <label name="nameLabel" styleClass="h2"/>
        <list name="songList" selectionMode="single-selection"/>
    </column-panel>
</row-panel>
