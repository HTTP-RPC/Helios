<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE column-panel SYSTEM "sierra.dtd">

<column-panel>
    <row-panel spacing="4" alignToBaseline="true" padding="8">
        <label name="nameLabel" styleClass="h1"/>
        <button name="playButton" icon="icons/play_arrow_24dp.svg; 20"
            focusable="false"
            toolTipText="play"
            style="buttonType: borderless"/>

        <spacer weight="1"/>

        <row-panel>
            <menu-button name="addToPlaylistButton" icon="icons/add_24dp.svg; 18"
                focusable="false"
                toolTipText="addToPlaylist"
                style="buttonType: borderless"/>

            <button name="editSongButton" icon="icons/edit_24dp.svg; 16"
                focusable="false"
                toolTipText="editSong"
                style="buttonType: borderless"/>

            <button name="deleteSongButton" icon="icons/delete_24dp.svg; 18"
                focusable="false"
                toolTipText="deleteSong"
                style="buttonType: borderless"/>
        </row-panel>
    </row-panel>

    <separator style="height: 1; stripeIndent: 0"/>

    <scroll-pane border="none" weight="1">
        <table name="songTable" rowSelectionMode="single-selection"/>
    </scroll-pane>
</column-panel>
