<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE column-panel SYSTEM "sierra.dtd">

<column-panel spacing="8">
    <row-panel spacing="4" alignToBaseline="true">
        <label name="nameLabel" styleClass="h1"/>
        <button name="playAllButton" icon="icons/play_arrow_24dp.svg; 20"
            focusable="false"
            toolTipText="playAll"
            style="buttonType: borderless"/>

        <spacer weight="1"/>

        <button name="editSelectedSongButton" icon="icons/edit_24dp.svg; 18"
            focusable="false"
            toolTipText="editSelectedSong"
            style="buttonType: borderless"/>
    </row-panel>

    <scroll-pane weight="1">
        <table name="songTable" rowSelectionMode="single-selection"/>
    </scroll-pane>
</column-panel>
