<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE column-panel SYSTEM "sierra.dtd">

<column-panel spacing="8" padding="8" opaque="true">
    <form-panel>
        <text-field name="artistTextField" label="artist" columns="24"/>
        <text-field name="albumTextField" label="album" columns="32"/>
        <text-field name="titleTextField" label="title" columns="32"/>

        <spacer height="4"/>

        <suggestion-picker name="genreSuggestionPicker" label="genre" columns="12"/>
        <number-field name="yearTextField" label="year" columns="4"/>

        <spacer height="4"/>

        <row-panel label="track" spacing="6" alignToBaseline="true">
            <number-field name="trackNumberTextField" columns="2"/>
            <label text="of"/>
            <number-field name="trackCountTextField" columns="2"/>
        </row-panel>

        <row-panel label="disc" spacing="6" alignToBaseline="true">
            <number-field name="discNumberTextField" columns="2"/>
            <label text="of"/>
            <number-field name="discCountTextField" columns="2"/>
        </row-panel>

        <spacer height="4"/>

        <column-panel>
            <check-box name="compilationCheckBox" text="compilation"/>
            <check-box name="classicalCheckBox" text="classical"/>
        </column-panel>

        <text-field name="composerTextField" label="composer" columns="24"/>
    </form-panel>

    <separator/>

    <row-panel spacing="8">
        <spacer weight="1"/>

        <button name="cancelButton" text="cancel"/>
        <button name="okButton" text="ok"/>
    </row-panel>
</column-panel>
