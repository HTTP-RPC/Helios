<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE row-panel SYSTEM "sierra.dtd">

<row-panel padding="32" opaque="true" background="Panel.background; 0.9">
    <spacer weight="1"/>

    <column-panel spacing="16" weight="3">
        <spacer weight="1"/>

        <label text="addingSongs" horizontalAlignment="center"/>
        <progress-bar name="progressBar"/>

        <spacer height="8"/>

        <row-panel>
            <spacer weight="1"/>
            <button name="cancelButton" text="cancel"/>
            <spacer weight="1"/>
        </row-panel>

        <spacer weight="1"/>
    </column-panel>

    <spacer weight="1"/>
</row-panel>
